<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!-- Three sections in Blizzard's objective tracker, built from Blizzard's own quest module.
	     They replace the "Quests" section; QuestPin.lua swaps them in. They start hidden;
	     the tracker shows each one only when it has quests. -->
	<Frame name="QuestPinZoneTracker" mixin="QuestPinZoneTrackerMixin" inherits="ObjectiveTrackerModuleTemplate" hidden="true"/>
	<Frame name="QuestPinPinnedTracker" mixin="QuestPinPinnedTrackerMixin" inherits="ObjectiveTrackerModuleTemplate" hidden="true"/>
	<Frame name="QuestPinReadyTracker" mixin="QuestPinReadyTrackerMixin" inherits="ObjectiveTrackerModuleTemplate" hidden="true"/>
</Ui>
